# GLM-5.3-Flash-NVFP4-Spark on 2x DGX Spark (TP=2 over Ray).
# Adapted from eugr/spark-vllm-docker recipes/glm-5.3-flash.yaml (commit 53bd8e0, 2026-09-17).
# The full FP8 checkpoint (zai-org/GLM-5.3-Flash, ~306 GiB) does not fit on two Sparks;
# this NVFP4 build (165B params; 58 files, 174.8 GiB on disk) is the one eugr's dual-Spark recipe uses.
MODEL_ID=local-inference-lab/GLM-5.3-Flash-NVFP4-Spark
# Preflight checks that the cached refs/main points at this snapshot on both nodes.
MODEL_REVISION=a608241037e4c2565356bff7ca293f2133888f88
TP_SIZE=2

# GLM-5.3-Flash uses MTP speculative decoding built into the checkpoint; no mods needed.
MODS=()

# Set on the containers rather than the serve process so Ray workers on the other
# node inherit them. Changing these requires ./stop.sh && ./start.sh.
MODEL_CONTAINER_ENV=(
  CUTE_DSL_ARCH=sm_121a
  VLLM_USE_AOT_COMPILE=1
  VLLM_USE_BREAKABLE_CUDAGRAPH=0
  VLLM_USE_MEGA_AOT_ARTIFACT=1
  VLLM_MEMORY_PROFILE_INCLUDE_ATTN=1
  VLLM_USE_FLASHINFER_SAMPLER=1
  VLLM_USE_B12X_WO_PROJECTION=1
  VLLM_USE_B12X_MHC=1
  VLLM_USE_B12X_FP8_GEMM=1
  VLLM_USE_B12X_MOE=1
  VLLM_USE_B12X_SPARSE_INDEXER=1
  VLLM_USE_V2_MODEL_RUNNER=1
  VLLM_MOE_SKIP_PADDING=0
  B12X_MLA_SM120_UNIFIED=1
  B12X_MOE_FORCE_A8=1
  # Weights are already cached on both nodes; never reach out to the Hub at startup.
  HF_HUB_OFFLINE=1
)

# Flags after `vllm serve $MODEL_ID`. start.sh adds --host/--port,
# --tensor-parallel-size and --distributed-executor-backend ray.
SERVE_ARGS=(
  --mamba-cache-mode align
  --enable-prefix-caching
  --enable-chunked-prefill
  --dtype bfloat16
  --kv-cache-dtype fp8
  --quantization modelopt_mixed
  --attention-backend B12X
  --block-size 256
  --moe-backend b12x
  --linear-backend b12x
  --no-enable-flashinfer-autotune
  --load-format b12x
  --max-model-len 1048576
  --max-num-seqs 8
  --max-num-batched-tokens 8192
  --kv-cache-memory-bytes 11G
  --gpu-memory-utilization 0.85
  --speculative-config '{"method":"mtp","num_speculative_tokens":5,"moe_backend":"humming","attention_backend":"B12X"}'
  --reasoning-parser glm45
  --tool-call-parser glm47
  --enable-auto-tool-choice
  --reasoning-config '{"reasoning_parser":"glm45","reasoning_start_str":"","reasoning_end_str":""}'
  --default-chat-template-kwargs.thinking=true
  --default-chat-template-kwargs.reasoning_effort=high
)
